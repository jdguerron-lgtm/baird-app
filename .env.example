# ─────────────────────────────────────────────
# Supabase Configuration
# Obtener en: https://app.supabase.com → Settings → API
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# OBLIGATORIA para el server-side (API routes, services, crons): src/lib/supabase-admin.ts
# lanza si falta. Settings → API → service_role. NUNCA con prefijo NEXT_PUBLIC. Ver docs/PLAN-RLS.md
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─────────────────────────────────────────────
# Google Gemini (IA para triaje — deshabilitado temporalmente)
# Obtener en: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ─────────────────────────────────────────────
# WhatsApp Business API (Meta Cloud API)
# Instrucciones de configuración: ver WHATSAPP_SETUP.md
# ─────────────────────────────────────────────

# Token de acceso (permanente desde Sistema de Usuarios de Meta Business)
WHATSAPP_API_TOKEN=your-whatsapp-permanent-token-here

# ID del número de teléfono (Panel de Meta → WhatsApp → Configuración API)
WHATSAPP_PHONE_ID=your-phone-number-id-here

# Verify Token: string personalizado que defines al registrar el webhook en Meta
# Puede ser cualquier string seguro, ej: "baird_webhook_secret_2025"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-custom-verify-token-here

# App Secret: se obtiene en Meta for Developers → Tu App → Configuración → Básica
# Se usa para verificar la firma de los webhooks entrantes (X-Hub-Signature-256)
WHATSAPP_WEBHOOK_SECRET=your-app-secret-here

# URL base del sitio (usada para generar los links de aceptación del técnico)
# En desarrollo: http://localhost:3000
# En producción: https://tudominio.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Cron Secret (Vercel Cron + endpoint /api/test-whatsapp)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Configurar en Vercel Dashboard → Settings → Environment Variables (Production + Preview)
# ─────────────────────────────────────────────
CRON_SECRET=your-cron-secret-here
# 'true' habilita GET/POST /api/test-whatsapp en producción (default apagado)
ENABLE_TEST_ENDPOINTS=false

# ─────────────────────────────────────────────
# Admin — allowlist de emails (server + cliente). Ver docs/SEGURIDAD.md
# ─────────────────────────────────────────────
ADMIN_EMAILS=jdguerron@bairdservice.com
NEXT_PUBLIC_ADMIN_EMAILS=jdguerron@bairdservice.com

# ─────────────────────────────────────────────
# Google Maps — geocoding de direcciones para /admin/mapa (opcional en local)
# ─────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─────────────────────────────────────────────
# WhatsApp — opcionales de operación
# ─────────────────────────────────────────────
# Número (digits con país) que recibe alerta por cada mensaje entrante al webhook
WHATSAPP_ALERT_PHONE=
# CSV de digits con país. Si está definida, NO se envía WhatsApp a números fuera de la lista (dev)
BAIRD_TEST_PHONE_WHITELIST=

# ─────────────────────────────────────────────
# Wompi — pasarela de pagos (anticipo + saldo). Ver docs/WOMPI.md
# Sin PUBLIC_KEY + INTEGRITY_SECRET todo Wompi es no-op (kill-switch). pub_test_ → sandbox
# ─────────────────────────────────────────────
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Reservada para API transaccional futura (hoy no se lee)
WOMPI_PRIVATE_KEY=

# ─────────────────────────────────────────────
# Resend — correo de facturación al completar un servicio. Ausente = no-op
# ─────────────────────────────────────────────
RESEND_API_KEY=
FACTURACION_EMAIL=logistica@encompasslatam.com
EMAIL_FROM="Baird Service <facturacion@bairdservice.com>"

# ─────────────────────────────────────────────
# Facturación — ver docs/FACTURACION.md (opcionales)
# ─────────────────────────────────────────────
FACTURACION_MABE_NIT=
FACTURACION_MABE_NOMBRE=MABE COLOMBIA S.A.S.

# ─────────────────────────────────────────────
# Dapta — segunda línea de voz IA (llamadas automatizadas)
# Doc: docs/DAPTA.md. Kill-switch global: DAPTA_ENABLED debe ser 'true' para
# que se dispare CUALQUIER llamada. En dev/staging dejar en 'false'.
# La whitelist de números reusa BAIRD_TEST_PHONE_WHITELIST (no se duplica).
# ─────────────────────────────────────────────
DAPTA_ENABLED=false
# Public Route URL del Flow de Dapta (POST con variables dinámicas + metadata)
DAPTA_PUBLIC_ROUTE_URL=
# Secreto para verificar la firma HMAC / token del webhook POST-CALL
DAPTA_WEBHOOK_SECRET=
# Tope de llamadas por solicitud
DAPTA_MAX_INTENTOS=2
# Horas de espera entre reintentos de llamada a la misma solicitud
DAPTA_REINTENTO_COOLDOWN_HORAS=4
# Ventana horaria hábil para llamar (hora local America/Bogota, 0–23)
DAPTA_HORARIO_INICIO=8
DAPTA_HORARIO_FIN=19
# Horas de silencio en WhatsApp antes de escalar a llamada, por propósito
# RESERVADAS para la Fase 1 del plan de voz — hoy ningún código las lee
DAPTA_SILENCIO_AGENDAR_HORAS=12
DAPTA_SILENCIO_CIERRE_HORAS=24
DAPTA_SILENCIO_COTIZACION_HORAS=24
DAPTA_SILENCIO_REPUESTO_HORAS=24
